# =============================================================================
# PostgreSQL Locaweb (obrigatório para login e APIs)
# =============================================================================
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=admxpress
DATABASE_USER=admxpress
DATABASE_PASSWORD=
DATABASE_SSL=false
# DATABASE_POOL_MAX=10

# PDFs de NF-e (armazenamento local no servidor)
# NFE_PDF_DIR=./storage/nfe-pdfs

# =============================================================================
# Supabase (legado — telas do dashboard ainda em migração; opcional)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# NF-e / NFS-e — prioridade: 1) Sistema Nacional (Porto Alegre), 2) Provedor genérico, 3) Simulado.

# 1) Sistema Nacional NFS-e (Porto Alegre) — certificado A1 (PFX) em base64
# NFSENACIONAL_AMBIENTE=homologacao
# NFSENACIONAL_CERT_PFX_BASE64=base64-do-arquivo.pfx
# NFSENACIONAL_CERT_SENHA=senha-do-certificado
# NFSENACIONAL_CNPJ=00000000000191
# NFSENACIONAL_RAZAO_SOCIAL=Razão Social do Prestador
# NFSENACIONAL_TELEFONE=5133334444
# NFSENACIONAL_SERIE_DPS=1
# NFSENACIONAL_COD_TRIBUTACAO_NACIONAL=080201
# NFSENACIONAL_COD_TRIBUTACAO_MUNICIPAL=01.03
# NFSENACIONAL_COD_NBS=122051900

# 2) Provedor genérico (qualquer API que aceite POST /nfe com JSON)
# NFE_API_URL=https://api.provedor.com
# NFE_API_KEY=sua-chave

# Chamados (suporte interno): ferramentas abrem ticket com POST /api/chamados e header:
#   Authorization: Bearer <CHAMADOS_INGEST_TOKEN>
# CHAMADOS_INGEST_TOKEN=defina-um-token-secreto

# Integração Site → Painel (cadastro público LicitaPregão trial)
# Site envia: Authorization: Bearer <SITE_API_KEY>
# SITE_API_KEY=defina-um-token-secreto-compartilhado-com-o-site

# Integração Painel → LicitaPregão (provisionamento automático de tenant)
# LICITAPREGAO_API_URL=https://licitapregao.xpresssolutions.com.br
# LICITAPREGAO_API_KEY=defina-um-token-secreto-compartilhado-com-licitapregao
# LICITAPREGAO_LOGIN_URL=https://licitapregao.xpresssolutions.com.br/login
# Sincronização admin → ferramenta: PATCH /api/sync-tenant (mesma LICITAPREGAO_API_KEY)
# LICITAPREGAO_PORTAL_URL=https://licitapregao.xpresssolutions.com.br/

# E-mail de boas-vindas do teste grátis (Resend ou SMTP do domínio)
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=noreply@xpresssolutions.com.br
# SMTP_HOST=mail.xpresssolutions.com.br
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=xpresssolutions@xpresssolutions.com.br
# SMTP_PASS=sua-senha-smtp
# SMTP_FROM_NAME=Xpress Solutions
# SMTP_REPLY_TO=suporte@xpresssolutions.com.br

# Multi-tenancy (API central para ferramentas como Apolicer)
# A ferramenta Apolicer chama GET /api/tenant-config?slug=xxx com este token no header:
#   Authorization: Bearer <CENTRAL_API_TOKEN>
# Se não definir, a rota /api/tenant-config retorna 401.
CENTRAL_API_TOKEN=seu-token-secreto-aqui

# Opcional: IPs confiáveis (separados por vírgula). Se o request vier de um desses IPs, aceita mesmo sem token.
# CENTRAL_TRUSTED_IPS=192.168.1.1,10.0.0.1
