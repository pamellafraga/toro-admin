# =============================================================================
# Toro Admin — Variáveis de ambiente
# Projeto independente da Xpress Solutions (sem vínculo com o repositório original)
# =============================================================================

# PostgreSQL (obrigatório para login, produtos e pedidos)
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=toro_admin
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false

# Integração Site Toro → Painel (https://toro-green.vercel.app)
# O site envia pedidos com: Authorization: Bearer <SITE_API_KEY>
SITE_API_KEY=defina-um-token-secreto-compartilhado-com-o-site
TORO_SITE_URL=https://toro-green.vercel.app

# Supabase (opcional — legado)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# SAC — integração do site/e-commerce para abrir tickets
# CHAMADOS_INGEST_TOKEN=defina-um-token-secreto

# E-mail (Resend ou SMTP)
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=contato@toro.com.br
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_NAME=Toro
# SMTP_REPLY_TO=contato@toro.com.br

# NF-e / NFS-e (opcional)
# NFSENACIONAL_AMBIENTE=homologacao
# NFE_API_URL=
# NFE_API_KEY=

# PDFs de NF-e (armazenamento local no servidor)
# NFE_PDF_DIR=./storage/nfe-pdfs
