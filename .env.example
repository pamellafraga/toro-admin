# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Service Role — só no servidor, para a página de Senhas e outras APIs admin.
# Em: Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# NF-e / NFS-e — prioridade: 1) Sistema Nacional (Porto Alegre), 2) Provedor genérico, 3) Simulado.

# 1) Sistema Nacional NFS-e (Porto Alegre) — certificado A1 (PFX) em base64
# NFSENACIONAL_AMBIENTE=homologacao
# NFSENACIONAL_CERT_PFX_BASE64=base64-do-arquivo.pfx
# NFSENACIONAL_CERT_SENHA=senha-do-certificado
# NFSENACIONAL_CNPJ=00000000000191
# NFSENACIONAL_RAZAO_SOCIAL=Razão Social do Prestador
# NFSENACIONAL_TELEFONE=5133334444
# NFSENACIONAL_SERIE_DPS=1
# NFSENACIONAL_COD_TRIBUTACAO_NACIONAL=080201
# NFSENACIONAL_COD_TRIBUTACAO_MUNICIPAL=01.03
# NFSENACIONAL_COD_NBS=122051900

# 2) Provedor genérico (qualquer API que aceite POST /nfe com JSON)
# NFE_API_URL=https://api.provedor.com
# NFE_API_KEY=sua-chave
