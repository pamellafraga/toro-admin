# MySQL na nuvem (Railway, TiDB, PlanetScale…) — para Vercel
# Copie de railway.app → MySQL → Connect → Public URL
DATABASE_URL=mysql://user:password@host:3306/database

# Alternativa: variáveis separadas
# DATABASE_HOST=
# DATABASE_PORT=3306
# DATABASE_NAME=
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_SSL=true

# PlanetScale serverless (HTTP — ideal para Vercel):
# DATABASE_URL=mysql://user:pass@aws.connect.psdb.cloud/db?sslaccept=strict
# DATABASE_DRIVER=planetscale
